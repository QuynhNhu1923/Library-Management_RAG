<% provide :title, @user.name %>

  <!-- ================= PROFILE SECTION ================= -->
  <div class="card shadow-sm border-0 rounded-4 p-4 mb-4"
     style="background: linear-gradient(1180deg, #475569, #64748b);">

    <div class="row align-items-center">

      <!-- AVATAR -->
      <div class="col-md-3 d-flex justify-content-center align-items-center">
        <%= gravatar_for @user %>
      </div>

      <!-- INFO -->
      <div class="col-md-9" style="color: #f8fafc;">

        <h2 class="mb-1 fw-bold" style="color: #f8fafc;">
          <%= @user.name %>
        </h2>

        <% if @user.email.present? %>
          <p class="mb-3" style="color: #f8fafc; opacity: 0.85;">
            <i class="bi bi-envelope me-1"></i>
            <%= @user.email %>
          </p>
        <% end %>

        <div class="row small">

          <div class="col-md-6 mb-2">
            <div class="fw-semibold" style="color: #f8fafc;">
              <%= t(".created_at") %>
            </div>
            <div style="color: #f8fafc; opacity: 0.8;">
              <%= l(@user.created_at, format: :long) %>
            </div>
          </div>

          <div class="col-md-6 mb-2">
            <div class="fw-semibold" style="color: #f8fafc;">
              <%= t(".updated_at") %>
            </div>
            <div style="color: #f8fafc; opacity: 0.8;">
              <%= l(@user.updated_at, format: :long) %>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <% if @user.user? %>
    <!-- ================= BORROW REQUESTS SECTION ================= -->
    <div class="card border-0 shadow-sm mb-3"
         style="background: linear-gradient(135deg, #eb7b35eb, #f0e78c9c);">

      <div class="card-body py-2 px-3 d-flex align-items-center gap-2">

        <i class="bi bi-journal-text fs-4 text-primary"></i>

        <h5 class="fw-bold mb-0 text-white">
          Your Borrow Requests
        </h5>

      </div>

    </div>

    <div class="card shadow-sm border-0 rounded-4 p-3">

      <%= render "borrow_list/table",
                 borrow_requests: @borrow_requests,
                 offset: @pagy.offset %>

      <div class="mt-3">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>

    </div>
  <% end %>
