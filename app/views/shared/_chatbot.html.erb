<!-- Thư viện hỗ trợ Render Markdown -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>


<div id="chatbot-container">
  <button id="chat-circle" class="btn text-white rounded-circle d-flex align-items-center justify-content-center" onclick="toggleChat()">
    <i class="fas fa-brain cute-robot-icon" style="font-size: 26px; color: white; animation: cuteBounce 3s infinite ease-in-out;"></i>
  </button>

  <div id="chat-box" class="card shadow-lg d-none" style="width: 350px; height: 450px; display: flex; flex-direction: column; position: absolute; bottom: 80px; right: 0;">
    <div class="card-header bg-custom-dark text-white d-flex justify-content-between align-items-center">
      <div>
        <h6 class="mb-0"><i class="fas fa-university me-2"></i>Thủ thư online</h6>
        <small style="font-size: 0.7rem; color: #cbd5e1;" id="current-date-display"></small>
      </div>
      <div class="d-flex align-items-center">
        <button type="button" class="btn btn-link text-white p-0 me-3" onclick="clearChat()" title="Xóa lịch sử trò chuyện" style="font-size: 0.95rem; text-decoration: none; border: none; box-shadow: none;">
          <i class="fas fa-trash-alt"></i>
        </button>
        <button type="button" class="btn-close btn-close-white" onclick="toggleChat()"></button>
      </div>
    </div>
    
    <div id="chat-content" class="card-body bg-light" style="flex: 1; overflow-y: auto; padding: 15px;">
      <div class="bot-msg mb-3">
        <div class="d-inline-block p-2 px-3 rounded-3 bg-white small text-dark shadow-sm border" style="max-width: 90%;">
          Xin chào! Mình là Thủ thư online, mình có thể giúp gì cho bạn về kho sách?
        </div>
      </div>
    </div>

    <div class="card-footer bg-white border-top p-2">
      <div class="input-group">
        <input type="text" id="chat-input" class="form-control border-0" placeholder="Hỏi về sách, tác giả, nội quy..." onkeypress="handleKeyPress(event)">
        <button class="btn btn-link text-custom-dark" onclick="processChat()">
          <i class="fas fa-paper-plane"></i>
        </button>
      </div>
    </div>
  </div>
</div>
