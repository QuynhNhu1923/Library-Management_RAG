<!-- Thư viện hỗ trợ Render Markdown -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  /* Thanh cuộn cho khung chat */
  #chat-content::-webkit-scrollbar {
    width: 4px;
  }
  #chat-content::-webkit-scrollbar-thumb {
    background: #64748b; /* Đổi màu thanh cuộn cho hợp tone */
    border-radius: 10px;
  }

  /* Định dạng tin nhắn của Bot (Markdown) */
  .markdown-body {
    line-height: 1.6;
    word-wrap: break-word;
  }
  .markdown-body p {
    margin-bottom: 0.8rem;
  }
  .markdown-body ul, .markdown-body ol {
    padding-left: 1.2rem;
    margin-bottom: 0.8rem;
  }
  .markdown-body li {
    margin-bottom: 0.3rem;
  }
  .markdown-body strong {
    color: #1e293b; 
  }

  /* Badge nguồn trích dẫn */
  .bot-msg .badge {
    transition: all 0.2s;
    font-weight: 400;
    white-space: normal;
    text-align: left;
  }
  .bot-msg .badge:hover {
    background-color: #e2e6ea !important;
    border-color: #334155 !important;
  }

  /* Container khung chat */
  #chatbot-container {
    z-index: 1050;
    position: fixed;
    bottom: 20px;
    right: 20px;
  }

  /* Hiệu ứng nhún nhảy dễ thương cho Icon */
  @keyframes cuteBounce {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(8deg); }
  }

  /* Đã đổi màu: Nút bấm mở chat theo phong cách màu mới của bạn */
  #chat-circle {
    width: 60px; 
    height: 60px; 
    background: linear-gradient(180deg, #1e293b, #334155); 
    border: none; 
    transition: all 0.3s ease;
    box-shadow: 0 6px 16px rgba(30, 41, 59, 0.4) !important;
  }
  #chat-circle:hover {
    transform: scale(1.08) translateY(-3px);
    box-shadow: 0 8px 24px rgba(30, 41, 59, 0.6) !important;
  }

  /* CSS helper cho màu sắc mới */
  .bg-custom-dark {
    background: linear-gradient(180deg, #1e293b, #334155) !important;
  }
  .text-custom-dark {
    color: #1e293b !important;
  }
</style>

<div id="chatbot-container">
  <button id="chat-circle" class="btn text-white rounded-circle d-flex align-items-center justify-content-center" onclick="toggleChat()">
    <i class="fas fa-brain cute-robot-icon" style="font-size: 26px; color: white; animation: cuteBounce 3s infinite ease-in-out;"></i>
  </button>

  <div id="chat-box" class="card shadow-lg d-none" style="...">
    <div class="card-header bg-custom-dark text-white d-flex justify-content-between align-items-center">
      <div>
        <h6 class="mb-0"><i class="fas fa-university me-2"></i>Thủ thư online</h6>
        <small style="font-size: 0.7rem; color: #cbd5e1;" id="current-date-display"></small>
      </div>
      <button type="button" class="btn-close btn-close-white" onclick="toggleChat()"></button>
    </div>
    
    <div id="chat-content" class="card-body bg-light" style="flex: 1; overflow-y: auto; padding: 15px;">
      <div class="bot-msg mb-3">
        <div class="d-inline-block p-2 px-3 rounded-3 bg-white text-dark shadow-sm border" style="max-width: 90%;">
          Xin chào! Mình là Thủ thư online, mình có thể giúp gì cho bạn về kho sách?
        </div>
      </div>
    </div>

    <div class="card-footer bg-white border-top p-2">
      <div class="input-group">
        <input type="text" id="chat-input" class="form-control border-0" placeholder="Hỏi về sách, tác giả, nội quy..." onkeypress="handleKeyPress(event)">
        <button class="btn btn-link text-custom-dark" onclick="processChat()">
          <i class="fas fa-paper-plane"></i>
        </button>
      </div>
    </div>
  </div>
</div>
