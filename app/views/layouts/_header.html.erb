<!-- Sidebar -->
<div class="sidebar d-flex flex-column">
  <h3 class="fw-bold sidebar-title text-center" style="line-height: 1.2;">
    <span style="background: linear-gradient(45deg, #ff00cc, #3333ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      The Book
    </span>
    <br />
    <span style="background: linear-gradient(45deg, #3333ff, #00d4ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 0.9em;">
      Oasis
    </span>
  </h3>

  <% if user_signed_in? && current_user%>
    <% if admin_user? %>
      <nav class="nav flex-column">
        <div class="nav-item"><%= link_to "📊 #{t('sidebar.dashboard')}", admin_report_path, class: "nav-link #{'active' if params[:controller] == "admin/reports"}" %></div>
        <div class="nav-item"><%= link_to "👥 #{t('sidebar.users')}", admin_users_path, class: "nav-link #{'active' if params[:controller] == "admin/users"}" %></div>
        <div class="nav-item"><%= link_to "📥 #{t('sidebar.borrow_requests')}", admin_borrow_requests_path, class: "nav-link #{'active' if current_page?(admin_borrow_requests_path)}" %></div>
        <div class="nav-item"><%= link_to "📚 #{t('sidebar.books')}", admin_books_path, class: "nav-link #{"active" if params[:controller] == "admin/books"}" %></div>
        <div class="nav-item"><%= link_to "✍️ #{t('sidebar.authors')}", admin_authors_path, class: "nav-link #{"active" if params[:controller] == "admin/authors"}" %></div>
        <div class="nav-item"><%= link_to "🗂 #{t('sidebar.categories')}", admin_categories_path, class: "nav-link #{"active" if params[:controller] == "admin/categories"}" %></div>
        <div class="nav-item"><%= link_to "🏢 #{t('sidebar.publishers')}", admin_publishers_path, class: "nav-link #{"active" if params[:controller] == "admin/publishers"}" %></div>
      </nav>
    <% else %>
      <nav class="nav flex-column">
        <div class="nav-item"><%= link_to "🏠 #{t("sidebar.home")}", root_path, class: "nav-link #{"active" if current_page?(root_path)}" %></div>
        <div class="nav-item"><%= link_to "🔍 #{t("sidebar.search")}", search_books_path, class: "nav-link #{"active" if current_page?(search_books_path)}" %></div>
        <div class="nav-item"><%= link_to "⭐ #{t("sidebar.favorite")}", favorites_user_path(current_user), class: "nav-link #{"active" if current_page?(favorites_user_path(current_user))}" %></div>
        <%# <div class="nav-item"><%= link_to "👤 #{t("sidebar.follow")}", follows_user_path(current_user), class: "nav-link" %>
        <div class="nav-item"><%= link_to "📚 #{t("sidebar.borrow_list")}", borrow_request_index_path, class: "nav-link #{'active' if current_page?(borrow_request_index_path)}" %></div>
      </nav>
    <% end %>
  <% else %>
    <nav class="nav flex-column">
      <div class="nav-item"><%= link_to "🏠 #{t("sidebar.home")}", root_path, class: "nav-link #{"active" if current_page?(root_path)}" %></div>
      <div class="nav-item"><%= link_to "🔍 #{t("sidebar.search")}", search_books_path, class: "nav-link #{"active" if current_page?(search_books_path)}" %></div>
    </nav>
  <% end %>
</div>

<!-- Topbar -->
<div class="topbar d-flex align-items-center justify-content-between px-4 py-2 bg-white shadow-sm border-bottom" style="height: 60px;">
  <% if user_signed_in? && current_user %>
    <div class="left-content">
      <span class="fw-bold fs-5 d-flex align-items-center gap-2">
        <%= gravatar_for current_user, size: 40 if current_user %>
        <%= current_user&.name %>
      </span>
    </div>

    <div class="right-buttons d-flex align-items-center gap-4">
      <!-- Giờ và ngày -->
      <div class="text-muted small text-end" id="current-time">
        <div class="fw-bold fs-3" id="current-hour">--:--</div>
        <div class="fs-6" id="current-date">--/--/----</div>
      </div>

      <!-- Dropdown Help xử lý bằng Stimulus -->
      <div class="dropdown" data-controller="dropdown">
        <button class="btn bg-light d-flex align-items-center gap-2 px-3 py-2 rounded border-0 dropdown-toggle no-arrow" 
                type="button" 
                id="helpDropdown" 
                data-bs-toggle="dropdown" 
                aria-expanded="false"
                data-action="click->dropdown#toggle">
          
          <!-- Icon Dấu hỏi chấm vòng tròn tinh tế như bạn cần -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;" class="text-secondary">
            <!-- Vòng tròn bên ngoài -->
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.084 1.085l-.284.284a.75.75 0 00-.218.53v.54m-.615 4.5h.008v.008h-.008V16.5zm-9-3.75a9 9 0 1118 0 9 9 0 01-18 0z" />
          </svg>
          <span class="text-secondary fw-semibold">Hỗ trợ</span>
        </button>
        
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="helpDropdown">
          <li>
            <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-bs-toggle="modal" data-bs-target="#rulesModal">
              📖 <span>Nội quy thư viện</span>
            </button>
          </li>
          <li>
            <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-bs-toggle="modal" data-bs-target="#contactModal">
              ✉️ <span>Liên hệ & Phản hồi</span>
            </button>
          </li>
        </ul>
      </div>

      <!-- Dropdown ⚙️ -->
      <div class="dropdown">
        <button class="btn text-dark fs-2 dropdown-toggle p-0" type="button" id="settingsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
          ⚙️
        </button>
        <ul class="dropdown-menu">
          <li><%= link_to t("topbar.profile"), current_user, class: "dropdown-item" %></li>
          <li><%= link_to t("topbar.settings"), edit_user_path(current_user), class: "dropdown-item" %></li>
          <li><hr class="dropdown-divider"></li>
          <li><%= link_to t("topbar.log_out"), destroy_user_session_path, data: { "turbo-method": :delete , method: :delete }, class: "dropdown-item" %></li>
        </ul>
      </div>
    </div>
  <% else %>
    <div class="left-content">
      <span class="fw-bold fs-5">👤 <%= t("topbar.guest") %></span>
    </div>

    <div class="right-buttons d-flex align-items-center gap-3">
      <!-- Dropdown Help xử lý bằng Stimulus -->
      <div class="dropdown" data-controller="dropdown">
        <button class="btn bg-light d-flex align-items-center gap-2 px-3 py-2 rounded border-0 dropdown-toggle no-arrow" 
                type="button" 
                id="helpDropdown" 
                data-bs-toggle="dropdown" 
                aria-expanded="false"
                data-action="click->dropdown#toggle">
          
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;" class="text-secondary">
          <!-- Vòng tròn bên ngoài -->
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.084 1.085l-.284.284a.75.75 0 00-.218.53v.54m-.615 4.5h.008v.008h-.008V16.5zm-9-3.75a9 9 0 1118 0 9 9 0 01-18 0z" />
        </svg>
        <span class="text-secondary fw-semibold">Hỗ trợ</span>
        </button>
        
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="helpDropdown">
          <li>
            <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-bs-toggle="modal" data-bs-target="#rulesModal">
              📖 <span>Nội quy thư viện</span>
            </button>
          </li>
          <li>
            <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-bs-toggle="modal" data-bs-target="#contactModal">
              ✉️ <span>Liên hệ & Phản hồi</span>
            </button>
          </li>
        </ul>
      </div>

      <%= link_to t("topbar.sign_in"), new_user_session_path, class: "btn btn-dark rounded-pill px-5 py-2 fs-6" %>
      <%= link_to t("topbar.sign_up"), new_user_registration_path, class: "btn btn-dark rounded-pill px-5 py-2 fs-6" %>
    </div>
  <% end %>
</div>

<!-- Gọi partial chứa cấu trúc Modal Nội quy bằng PDF -->
<%= render "shared/rules_modal" %>
<!-- Language Switcher -->
<div class="dropdown locale-switcher">
  <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="localeDropdown" data-bs-toggle="dropdown" aria-expanded="false">
    🌐 <%= t("language") %>
  </button>
  <ul class="dropdown-menu">
    <li><%= link_to t("languages.en"), request.params.merge(locale: :en)%></li>
    <li><%= link_to t("languages.vi"), request.params.merge(locale: :vi)%></li>
  </ul>
</div>

<script>
  (function() {
    function updateClock() {
      const h = document.getElementById('current-hour');
      const d = document.getElementById('current-date');
      if (!h || !d) return;

      const now = new Date();
      h.textContent = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      d.textContent = now.toLocaleDateString('en-GB');
    }

    // Chạy ngay lập tức
    updateClock();
    
    // Hỗ trợ Rails Turbo: Chạy lại khi chuyển trang
    document.addEventListener("turbo:load", updateClock);
    document.addEventListener("DOMContentLoaded", updateClock);
    
    // Cập nhật mỗi phút
    setInterval(updateClock, 60000);
  })();
</script>
