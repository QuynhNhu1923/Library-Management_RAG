<% provide :title, @book.title %>

<div class="py-4 px-4">

  <!-- BACK BUTTON -->
  <%= link_to "← #{t(".back_to_home")}",
      root_path,
      class: "btn btn-outline-secondary mb-4" %>

  <!-- ================= MAIN LAYOUT ================= -->
  <div class="row g-4 book_detail">

    <!-- ================= LEFT: IMAGE + ACTION ================= -->
    <div class="col-md-4">

      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">

        <% if @book.image.attached? %>
          <%= image_tag @book.image.variant(resize_to_limit: [300, 400]),
              class: "img-fluid rounded book_detail-image" %>
        <% else %>
          <%= image_tag Setting.images.default_cover,
              class: "img-fluid rounded book_detail-image" %>
        <% end %>

        <div class="mt-4">
          <%= render partial: "favorite_button", locals: { item: @book } %>
          <%= button_tag t(".borrow"), class: "borrow_button", type: "button" %>
          <%= render "borrow_modal", book: @book %>
        </div>

      </div>

    </div>

    <!-- ================= RIGHT: BOOK INFO ================= -->
    <div class="col-md-8">

      <div class="card border-0 shadow-sm rounded-4 p-4">

        <h2 class="fw-bold mb-3"><%= @book.title %></h2>

        <p><strong><%= t(".rating") %>:</strong>
          <%= @book.average_rating %> / <%= Settings.digits.digit_5 %> ★
        </p>

        <p><strong><%= t(".read_count") %>:</strong>
          <%= @book.borrow_count || 0 %>
        </p>

        <p>
          <strong><%= t(".available_quantity") %>:</strong>
          <%= @book.available_quantity %>

          <% if @book.available_quantity > 0 %>
            <span class="badge bg-success"><%= t(".in_stock") %></span>
          <% else %>
            <span class="badge bg-danger"><%= t(".out_of_stock") %></span>
          <% end %>
        </p>

        <hr>

        <p class="fw-bold"><%= t(".description") %></p>
        <p><%= @book.description.presence || t(".no_description") %></p>

        <!-- META INFO -->
        <div class="row g-3 mt-3">

          <div class="col-md-4">
            <div class="p-3 border rounded text-center">
              <strong><%= t(".year") %></strong><br>
              <span class="text-warning"><%= @book.publication_year %></span>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-3 border rounded text-center">
              <strong><%= t(".category") %></strong><br>
              <span class="text-warning">
                <%= @book.categories.map(&:name).join(", ") %>
              </span>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-3 border rounded text-center">
              <strong><%= t(".publisher") %></strong><br>
              <span class="text-warning">
                <%= @book.publisher&.name %>
              </span>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- ================= PDF ================= -->
  <% if @book.pdf_file.attached? %>
    <div class="card border-0 shadow-sm rounded-4 p-3 mt-4">
      <%= render "pdf_viewer", book: @book %>
    </div>
  <% end %>

  <!-- ================= AUTHOR ================= -->
  <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
    <div class="author-info-wrapper mb-5 ps-5 pe-5"> 
      <div class="author-border-line"></div> 
        <h4><strong><%= t(".about_author") %></strong></h4>
        <div class="row align-items-center px-3 py-4 m-2">
          <div class="col-md-2 text-center">
          <% if @book.author&.image&.attached? %>
            <%= image_tag @book.author.image.variant(resize_to_limit: [100, 100]), class: "rounded-circle author-avatar" %>
          <% else %>
            <%= image_tag Settings.images.default_author, class: "rounded-circle author-avatar" %>
          <% end %>
        </div>
        <div class="col-md-10">
          <h4><strong><%= link_to @book.author.name, author_path(@book.author), class: "text-dark" %></strong></h4>
          <div class="mb-2 text-muted">
            <span><%= t(".no_of_books") %>: <%= @book.author.books.count %></span> |
            <span><%= t(".no_of_followers") %>: 0</span>
          </div>
          <p><%= @book.author.bio.presence || t(".no_bio") %></p>
        </div>
      </div>
      <div class="author-border-line"></div> 
    </div>
  </div>
  <!-- ================= RECOMMENDED ================= -->
  <% if @book.author && @recommended_books.present? %>

    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">

      <h4 class="fw-bold mb-3"><%= t(".more_books_by_author") %></h4>

      <%= turbo_frame_tag "recommended_books" do %>
        <%= render partial: "recommended_books" %>
      <% end %>

    </div>

  <% end %>

  <!-- ================= REVIEWS ================= -->
  <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">

    <h5 class="text-primary mb-3"><%= t(".rating_and_reviews") %></h5>

    <div class="row">

      <div class="col-md-6">
        <%= render "books/review_section",
            book: @book,
            review: @user_review %>
      </div>

      <div class="col-md-6">
        <%= render "books/community_rating",
            book: @book,
            review_counts: @review_counts,
            total_reviews: @total_reviews %>
      </div>

    </div>

  </div>

  <!-- ================= COMMENTS ================= -->
  <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">

    <h4 class="fw-bold mb-3"><%= t(".readers_reviews") %></h4>

    <%= turbo_frame_tag "reviews" do %>
      <%= render partial: "books/reviews",
          locals: { pagy_reviews: @pagy_reviews, reviews: @reviews } %>
    <% end %>

  </div>

</div>
