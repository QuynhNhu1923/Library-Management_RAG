<div class="row mt-4 mb-5 px-3">
  <div class="col-12">
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-dark">
          <i class="fas fa-book-open me-2 text-primary"></i>
          <%= t(".pdf_preview", default: "Đọc thử trực tuyến") %>
        </h5>
        <% if book.pdf_file.attached? %>
          <span class="badge bg-info-soft text-primary">Bản xem trước</span>
        <% end %>
      </div>
      
      <div class="card-body bg-light p-3">
        <%# Đổi từ pdf_file sang preview_pdf %>
        <% if book.preview_pdf.attached? %>
          <div class="shadow-sm rounded overflow-hidden bg-white" style="height: 800px; position: relative;">
            <iframe 
              src="<%= rails_blob_path(book.preview_pdf, disposition: "inline") %>#toolbar=1" 
              width="100%" 
              height="100%" 
              style="border: none; display: block;">
            </iframe>
          </div>

          <div class="mt-3 d-flex justify-content-between align-items-center px-2">
            <span class="text-muted small">
              <strong>Tên file:</strong> <%= book.preview_pdf.filename %> 
              (<%= number_to_human_size(book.preview_pdf.byte_size) %>)
            </span>
            
            <%# Tùy Như quyết định: Có cho tải bản Preview về hay không %>
            <%= link_to rails_blob_path(book.preview_pdf, disposition: "attachment"), class: "btn btn-sm btn-outline-primary" do %>
              <i class="fas fa-download me-1"></i> Tải bản đọc thử
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-5 bg-white rounded shadow-sm">
            <i class="fas fa-file-pdf fa-3x text-secondary mb-3"></i>
            <p class="text-muted">Hiện tại chưa có bản đọc thử cho cuốn sách này.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
