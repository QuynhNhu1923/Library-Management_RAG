<%# app/views/admin/books/_pdf_handler.html.erb %>
<div class="row mt-4">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 text-dark">
          <i class="fas fa-file-pdf me-2 text-danger"></i>
          <%= t("admin.books.pdf_viewer.title", default: "Bản điện tử & Phân tích AI") %>
        </h5>
        
        <% if book.pdf_file.attached? %>
          <%= button_to process_pdf_admin_book_path(book), 
                method: :post, 
                class: "btn btn-primary btn-sm shadow-sm",
                data: { turbo_confirm: "Hệ thống sẽ bắt đầu đọc và phân tích văn bản. Tiếp tục?" } do %>
            <i class="fas fa-robot me-1"></i> <%= t("admin.books.actions.process_rag", default: "Phân tích RAG") %>
          <% end %>
        <% end %>
      </div>

      <div class="card-body bg-light">
        <% if book.pdf_file.attached? %>
          <div class="ratio ratio-16x9 shadow-sm rounded overflow-hidden bg-white" style="height: 700px;">
            <embed 
              src="<%= url_for(book.pdf_file) %>" 
              type="application/pdf" 
              width="100%" 
              height="100%" 
            />
          </div>
          
          <div class="mt-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">
              <i class="fas fa-hdd me-1"></i> <%= number_to_human_size(book.pdf_file.byte_size) %>
            </span>
            <%= link_to rails_blob_path(book.pdf_file, disposition: "attachment"), class: "btn btn-link btn-sm text-decoration-none" do %>
              <i class="fas fa-download"></i> Tải PDF gốc
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="fas fa-file-upload fa-3x text-light mb-3"></i>
            <p class="text-muted"><%= t("admin.books.placeholders.no_pdf_attached", default: "Chưa có tệp PDF nào được tải lên cho sách này.") %></p>
            <%= link_to edit_admin_book_path(book), class: "btn btn-outline-primary btn-sm" do %>
              <i class="fas fa-plus"></i> Cập nhật tệp PDF
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if book.book_sections.any? %>
  <div class="row mt-4 mb-5">
    <div class="col-12">
      <div class="card border-info shadow-sm">
        <div class="card-header bg-info text-white">
          <h6 class="mb-0"><i class="fas fa-microchip me-2"></i>Dữ liệu đã nạp vào AI (<%= book.book_sections.count %> đoạn)</h6>
        </div>
        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th width="10%">Trang</th>
                <th>Nội dung trích xuất (Preview)</th>
              </tr>
            </thead>
            <tbody>
              <% book.book_sections.each do |section| %>
                <tr>
                  <td class="text-center fw-bold text-primary">#<%= section.metadata["page"] %></td>
                  <td><small class="text-muted"><%= truncate(section.content, length: 200) %></small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>
