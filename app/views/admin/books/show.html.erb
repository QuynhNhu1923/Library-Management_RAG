<%# app/views/admin/books/show.html.erb %>
<div class="card shadow-sm p-4 mb-4">
  <div class="row">
    <div class="col-md-4 text-center">
      <% if @book.image.attached? %>
        <%= image_tag @book.image.variant(resize_to_limit: [300, 450]),
              class: "img-fluid rounded shadow-sm mb-3 border" %>
      <% else %>
        <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3" style="height: 350px;">
          <span class="text-muted"><%= t("admin.books.placeholders.no_cover_image") %></span>
        </div>
      <% end %>
    </div>

    <div class="col-md-8">
      <h3 class="mb-3 text-primary fw-bold"><%= @book.title %></h3>
      
      <div class="row g-3">
        <div class="col-12">
          <p class="mb-2"><strong><%= t("admin.books.attributes.description") %>:</strong></p>
          <div class="p-3 bg-light rounded italic text-secondary">
            <%= @book.description.presence || t("admin.books.placeholders.no_description") %>
          </div>
        </div>
        
        <div class="col-sm-6">
          <p><strong><%= t("admin.books.attributes.author") %>:</strong> <%= @book.author.name %></p>
          <p><strong><%= t("admin.books.attributes.publisher") %>:</strong> <%= @book.publisher.name %></p>
          <p><strong><%= t("admin.books.attributes.publication_year") %>:</strong> <%= @book.publication_year %></p>
        </div>
        
        <div class="col-sm-6">
          <p><strong><%= t("admin.books.attributes.total_quantity") %>:</strong> <%= @book.total_quantity %></p>
          <p><strong><%= t("admin.books.attributes.available_quantity") %>:</strong> <%= @book.available_quantity %></p>
          <p><strong><%= t("admin.books.attributes.category") %>:</strong> 
            <span class="badge bg-info text-dark"><%= @book.categories.map(&:name).join(", ") %></span>
          </p>
        </div>
      </div>

      <div class="mt-4 pt-3 border-top d-flex gap-2">
        <%= link_to admin_books_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i> <%= t("admin.books.actions.back") %>
        <% end %>
        <%= link_to edit_admin_book_path(@book), class: "btn btn-success" do %>
          <i class="fas fa-edit me-1"></i> <%= t("admin.books.actions.edit") %>
        <% end %>
        <%= link_to admin_book_path(@book),
              data: { turbo_method: :delete, turbo_confirm: t("admin.books.confirmations.delete") },
              class: "btn btn-danger" do %>
          <i class="fas fa-trash me-1"></i> <%= t("admin.books.actions.delete") %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render "pdf_handler", book: @book %>
