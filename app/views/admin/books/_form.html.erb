<%= form_with model: [:admin, book], local: true, class: "needs-validation", html: { multipart: true } do |f| %>
  <%= render "admin/shared/error_messages", object: book %>

  <div class="mb-3">
    <%= f.label :title, t("admin.books.attributes.title"), class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, t("admin.books.attributes.description"), class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :pdf_file, "Tải lên bản PDF của sách", class: "form-label fw-bold" %>
    
    <%# Hiển thị thông tin file hiện tại nếu đã có %>
    <% if book.pdf_file.attached? %>
      <div class="alert alert-info d-flex align-items-center py-2 px-3 mb-2">
        <i class="fas fa-file-pdf me-2 fs-4 text-danger"></i>
        <div class="small">
          <span class="d-block text-dark fw-bold">Tệp hiện tại: <%= book.pdf_file.filename %></span>
          <span class="text-muted"><%= number_to_human_size(book.pdf_file.byte_size) %></span>
        </div>
        <a href="<%= url_for(book.pdf_file) %>" target="_blank" class="ms-auto btn btn-sm btn-link text-decoration-none">
          <i class="fas fa-external-link-alt"></i> Xem thử
        </a>
      </div>
    <% end %>

    <%= f.file_field :pdf_file, accept: 'application/pdf', class: "form-control" %>
    <div class="form-text text-muted italic">Chọn tệp mới nếu bạn muốn thay thế bản hiện tại.</div>
  </div>

  <div class="mb-3">
    <%= f.label :publication_year, t("admin.books.attributes.publication_year"), class: "form-label" %>
    <%= f.number_field :publication_year, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :total_quantity, t("admin.books.attributes.total_quantity"), class: "form-label" %>
    <%= f.number_field :total_quantity, class: "form-control", min: 0 %>
  </div>

  <div class="mb-3">
    <%= f.label :available_quantity, t("admin.books.attributes.available_quantity"), class: "form-label" %>
    <%= f.number_field :available_quantity, class: "form-control", min: 0 %>
  </div>

  <div class="mb-3">
    <%= f.label :category_ids, t("admin.books.attributes.category"), class: "form-label" %>
    <div class="checkbox-group">
      <%= hidden_field_tag "book[category_ids][]", "" %>
      <% Category.all.each do |category| %>
        <label class="custom-checkbox">
          <input type="checkbox" 
                 name="book[category_ids][]" 
                 value="<%= category.id %>" 
                 <%= "checked" if book.category_ids.include?(category.id) %>>
          <span class="checkmark"></span>
          <span><%= category.name %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :author_id, t("admin.books.attributes.author"), class: "form-label" %>
    <%= f.collection_select :author_id, Author.all, :id, :name, { prompt: t("admin.books.prompts.select_author") }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :publisher_id, t("admin.books.attributes.publisher"), class: "form-label" %>
    <%= f.collection_select :publisher_id, Publisher.all, :id, :name, { prompt: t("admin.books.prompts.select_publisher") }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :image, t("admin.books.attributes.image"), class: "form-label fw-bold" %>
    
    <% if book.image.attached? %>
      <div class="mb-2">
        <%= image_tag book.image.variant(resize_to_limit: [100, 100]), class: "img-thumbnail mb-2 d-block shadow-sm" %>
        <span class="badge bg-secondary">Ảnh hiện tại: <%= book.image.filename %></span>
      </div>
    <% end %>

    <%= f.file_field :image, class: "form-control", accept: 'image/*' %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit submit_text, class: "btn btn-success btn-sm w-auto" %>
    <%= link_to t("admin.books.actions.cancel"), cancel_path, class: "btn btn-secondary" %>
  </div>
<% end %>
